<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:WEBit.App.Controls"
        x:Class="WEBit.App.Views.TrayFlyoutWindow"
        Title="WEBit"
        Width="380"
        SizeToContent="Height"
        MaxHeight="620"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <!-- Transparent window: the rounded border is the visible panel (like the tray context menu) -->
  <Border Background="{DynamicResource BrushBgSidebar}"
          BorderBrush="{DynamicResource BrushBorder}"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True"
          Padding="0">
    <DockPanel>

      <!-- Header -->
      <Border DockPanel.Dock="Top" Padding="16,14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Image Source="/Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="WEBit" FontWeight="Bold" FontSize="15" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" Fill="{Binding StatusDotBrush}" VerticalAlignment="Center" />
              <TextBlock Classes="muted small" Text="{Binding StatusPillText}" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Classes="icon small" Click="OnClose" ToolTip.Tip="{DynamicResource BtnClose}">
            <PathIcon Data="{StaticResource IconClose}" />
          </Button>
        </Grid>
      </Border>

      <!-- Footer -->
      <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Click="OnOpenUrls">
            <ctl:IconLabel Icon="{StaticResource IconLink}" Text="{DynamicResource NavUrls}" />
          </Button>
          <Button Grid.Column="2" Classes="primary" Click="OnOpenManager">
            <ctl:IconLabel Icon="{StaticResource IconWindow}" Text="{DynamicResource TrayOpenManager}" />
          </Button>
        </Grid>
      </Border>

      <!-- Sites -->
      <ScrollViewer MaxHeight="420">
        <StackPanel Margin="8">
          <TextBlock Classes="muted" Text="{DynamicResource EmptySitesTitle}" Margin="8" IsVisible="{Binding Sites.HasNoSites}" />
          <ItemsControl ItemsSource="{Binding Sites.Cards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,6" CornerRadius="6">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted small" Text="{Binding PrimaryUrl}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                      <Button Classes="icon small" Command="{Binding CopyUrlCommand}" ToolTip.Tip="{DynamicResource TipCopyUrl}">
                        <PathIcon Data="{StaticResource IconCopy}" />
                      </Button>
                      <Button Classes="icon small" Command="{Binding OpenCommand}" ToolTip.Tip="{DynamicResource TipOpenBrowser}">
                        <PathIcon Data="{StaticResource IconOpenInNew}" />
                      </Button>
                      <Button Classes="icon small" Command="{Binding ToggleRunCommand}" ToolTip.Tip="{Binding ToggleRunTip}">
                        <PathIcon Data="{Binding ToggleRunIcon}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
