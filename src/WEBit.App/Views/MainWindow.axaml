<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WEBit.App.ViewModels"
        xmlns:v="using:WEBit.App.Views"
        xmlns:ctl="using:WEBit.App.Controls"
        x:Class="WEBit.App.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/webit.ico"
        Background="{DynamicResource BrushBgApp}"
        Width="1360" Height="860"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">

    <!-- Sidebar -->
    <Border Grid.RowSpan="2"
            Classes="sidebar"
            Classes.collapsed="{Binding IsSidebarCollapsed}"
            Width="{Binding SidebarWidth}"
            Background="{DynamicResource BrushBgSidebar}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Logo: click toggles the sidebar -->
        <Button DockPanel.Dock="Top"
                Classes="logo"
                Margin="10,12,10,18"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="{DynamicResource TipToggleSidebar}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="/Assets/logo.png" Width="34" Height="34" />
            <TextBlock Text="WEBit" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                       IsVisible="{Binding !IsSidebarCollapsed}" />
          </StackPanel>
        </Button>

        <ListBox DockPanel.Dock="Bottom"
                 Classes="nav"
                 Margin="10,0,10,14"
                 ItemsSource="{Binding BottomNav}"
                 SelectedItem="{Binding SelectedBottomNav}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="14" ToolTip.Tip="{Binding Title}">
                <PathIcon Data="{Binding Icon}" Width="20" Height="20" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                           IsVisible="{Binding !$parent[Window].DataContext.IsSidebarCollapsed}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border DockPanel.Dock="Bottom" Classes="divider" Margin="16,8" />

        <ListBox Classes="nav"
                 Margin="10,0,10,0"
                 ItemsSource="{Binding TopNav}"
                 SelectedItem="{Binding SelectedTopNav}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="14" ToolTip.Tip="{Binding Title}">
                <PathIcon Data="{Binding Icon}" Width="20" Height="20" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                           IsVisible="{Binding !$parent[Window].DataContext.IsSidebarCollapsed}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Header: page title only -->
    <Border Grid.Column="1"
            Padding="28,18,24,16"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Page icon (same as in the sidebar) in accent color -->
        <PathIcon Data="{Binding CurrentPageIcon}" Width="24" Height="24" Margin="0,0,12,0"
                  Foreground="{DynamicResource BrushAccentHover}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="h1" Text="{Binding CurrentPage.Title}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- Status pill: the whole pill carries the status color -->
          <Border Classes="pill" Background="{Binding StatusPillBackground}" BorderBrush="{Binding StatusDotBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusPillText}" Classes="small" Foreground="{Binding StatusDotBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <Button Classes="icon small" Command="{Binding RefreshCommand}" ToolTip.Tip="{DynamicResource TipRefresh}">
            <PathIcon Data="{StaticResource IconRefresh}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content -->
    <Grid Grid.Row="1" Grid.Column="1">
      <!-- All visited pages stay in the tree; switching only toggles visibility -->
      <ctl:PageHost Page="{Binding CurrentPage}"
                    IsVisible="{Binding ShowPage}"
                    Margin="28,20,24,20" />

      <!-- Service not reachable: everything centered -->
      <Border IsVisible="{Binding ShowOfflinePanel}"
              Classes="card"
              Width="600"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="36,32">
        <StackPanel Spacing="16" HorizontalAlignment="Center">
          <Image Source="/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" />
          <TextBlock Classes="h2" Text="{Binding OfflineTitle}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding OfflineText}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <!-- All buttons share one fixed width -->
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Classes="offline" Command="{Binding ReconnectCommand}">
              <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnReconnect}" />
            </Button>
            <Button Classes="offline" Command="{Binding StartDesktopModeCommand}" IsVisible="{Binding CanStartDesktopMode}">
              <ctl:IconLabel Icon="{StaticResource IconConsole}" Text="{DynamicResource BtnStartDesktopMode}" />
            </Button>
          </StackPanel>
          <Button Classes="primary offline" HorizontalAlignment="Center" Command="{Binding UpdateServiceCommand}" IsVisible="{Binding CanUpdateService}">
            <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnUpdateService}" />
          </Button>
          <Button Classes="primary offline" HorizontalAlignment="Center" Command="{Binding InstallServiceCommand}" IsVisible="{Binding CanInstallService}">
            <ctl:IconLabel Icon="{StaticResource IconShield}" Text="{DynamicResource BtnInstallService}" />
          </Button>
        </StackPanel>
      </Border>

      <!-- Toast -->
      <Border x:Name="ToastHost"
              Classes="toast"
              Classes.error="{Binding ToastIsError}"
              IsVisible="{Binding HasToast}"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="24,0,24,22"
              MinWidth="240"
              MaxWidth="460">
        <!-- Icon, text and close button share one vertical center -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Classes="toastIcon" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Toast}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="20" />
          <Button Grid.Column="2" Classes="icon small" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding CloseToastCommand}">
            <PathIcon Data="{StaticResource IconClose}" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
